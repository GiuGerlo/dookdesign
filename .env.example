# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
# .env* NUNCA se commitea salvo este example (ver .claude/rules/security.md).

# App
NEXT_PUBLIC_APP_NAME=dookdesign

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Web Analytics (dashboard /admin/analytics). Solo server-side.
# VERCEL_TOKEN: crear en https://vercel.com/account/tokens (scope de la cuenta/team). SECRETO.
VERCEL_TOKEN=
# IDs del proyecto/team (no son secretos).
VERCEL_PROJECT_ID=prj_xGRqrECCOn0liLkRCOFn444kz5Kc
VERCEL_TEAM_ID=team_liaGvKVYeD3UxrjmNzQRuqM2
